// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}


datasource db {
  provider = "sqlserver"
}

model MaterialDefinition {
  id          String   @id @default(cuid())
  name        String
  description String?
  cost        Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  boards BoardDefinition[]
}

model BoardDefinition {
  id         String   @id @default(cuid())
  name       String
  width      Float
  height     Float
  materialId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  erpItemRefId Int?
  boardType  String?

  material MaterialDefinition? @relation(fields: [materialId], references: [id])
  boxTypes BoxType[]
  orders   Order[]
}

model BoxType {
  id                String   @id @default(cuid())
  name              String
  description       String?
  boardDefinitionId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  erpItemRefId Int?
  
  boardDefinition BoardDefinition @relation(fields: [boardDefinitionId], references: [id])
  sheets          BoxTypeSheet[]
  orders          Order[]
  boxSheetMappings  BoxSheetMapping[]
}

model BoxTypeSheet {
  id                    String   @id @default(cuid())
  boxTypeId             String
  sheetKey              String
  width                 Float
  height                Float
  quantity              Int
  productionTimeMinutes Int      @default(0)
  polyBagWidthMm Float @default(0)
  polyBagHeightMm Float @default(0)
  polyethyleneWeightPer1000 Float @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  erpItemRefId Int?
  erpItemRefIdPcs Int?

  boxType  BoxType       @relation(fields: [boxTypeId], references: [id], onDelete: Cascade)
  surfaces SurfaceSpec[]

  @@unique([boxTypeId, sheetKey])
}

model SurfaceSpec {
  id               String   @id @default(cuid())
  boxTypeSheetId   String
  surfaceName      String
  requiresPrinting Boolean  @default(false)
  imageUrl         String?
  imageColor       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  boxTypeSheet BoxTypeSheet @relation(fields: [boxTypeSheetId], references: [id], onDelete: Cascade)
}

model Order {
  id Int @id @default(autoincrement())

  orderNo String? @unique

  boxTypeId   String
  boardTypeId String

  quantity Int

  orderDate    DateTime
  deliveryDate DateTime

  status String @default("PENDING")

  createdAt DateTime @default(now())

  usdRatePerBox Float?

  lkrRatePerBox Float?

  usdToLkrRate Float?
  
  salesOrderDetailId Int?

  boxType BoxType @relation(fields: [boxTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  boardType BoardDefinition @relation(fields: [boardTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  plannings ProductionPlanning[]

  @@map("Orders")
}
model ProductionPlanning {
  id Int @id @default(autoincrement())

  planningNo String? @unique

  orderId Int

  plannedQuantity Int

  totalParts Int
  totalPiecesRequired Int
  totalSlatsRequired Int
  totalBoardsRequired Int
  totalProductionTimeMinutes Int

  status String @default("PLANNING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  parts ProductionPlanningPart[]

  logs ProductionPlanningLog[]

  utilizations ProductionEmployeeUtilization[]

  @@map("ProductionPlanning")
}

model ProductionPlanningPart {
  id Int @id @default(autoincrement())

  planningId Int

  sheetKey String
  sheetLabel String

  pieceWidth Float
  pieceHeight Float

  quantityPerBox Int
  totalPiecesRequired Int

  boardWidth Float
  boardHeight Float

  cuttingWidth Float
  cuttingHeight Float

  orientation String

  piecesPerSlat Int
  slatsPerBoard Int
  piecesPerBoard Int

  totalSlatsRequired Int
  totalBoardsRequired Int

  remainingBoardWidth Float
  remainingBoardHeight Float

  productionTimeMinutesPerPiece Int
  totalProductionTimeMinutes Int

  polyBagWidthMm Float @default(0)
  polyBagHeightMm Float @default(0)

  polyethyleneWeightPer1000 Float @default(0)
  totalPolyethyleneRequirementKg Float @default(0)

  createdAt DateTime @default(now())

  planning ProductionPlanning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@map("ProductionPlanningPart")
}

model ProductionPlanningLog {
  id         Int      @id @default(autoincrement())

  planningId Int

  orderId    Int

  logDate    DateTime @default(now())

  userId     Int      @default(0)

  status     String

  planning ProductionPlanning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  @@map("ProductionPlanningLog")
}

model EmployeeMaster {
  empId    Int    @id @default(autoincrement())

  empCode  String @unique
  empName  String

  utilizations ProductionEmployeeUtilization[]
}

model ProductionEmployeeUtilization {
  id           Int      @id @default(autoincrement())

  planningId   Int
  employeeId   Int

  workingHours Float

  workDate     DateTime @default(now())

  createdAt    DateTime @default(now())

  planning ProductionPlanning  @relation(fields: [planningId], references: [id], onDelete: Cascade)

  employee EmployeeMaster @relation(fields: [employeeId], references: [empId], onDelete: NoAction)
}

model BoxSheetMapping {
  id             Int      @id @default(autoincrement())

  boxTypeId      String

  sheetType      String

  quantityPerBox Int

  createdAt      DateTime @default(now())

  updatedAt      DateTime @updatedAt

  boxType BoxType @relation(fields: [boxTypeId], references: [id], onDelete: Cascade )
}